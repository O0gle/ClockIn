/**app.wxss**/
page {
  background-color: #f6f8fb;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  color: #1e293b;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, input, button {
  box-sizing: border-box;
}

/* 通用卡片阴影与圆角 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.05);
  transition: all 0.2s ease;
}

.card:active {
  transform: scale(0.998);
}

/* 标签通用样式 (自适应文本宽度，绝不压缩) */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  height: 44rpx;
  line-height: 40rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  vertical-align: middle;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
  flex-shrink: 0;
  width: auto;
}

.badge-success {
  background-color: #ecfdf5;
  color: #059669;
  border: 1rpx solid #a7f3d0;
}

.badge-warning {
  background-color: #fffbeb;
  color: #d97706;
  border: 1rpx solid #fde68a;
}

.badge-accent {
  background-color: #f5f3ff;
  color: #7c3aed;
  border: 1rpx solid #ddd6fe;
}

.badge-danger {
  background-color: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}

.badge-info {
  background-color: #eff6ff;
  color: #2563eb;
  border: 1rpx solid #bfdbfe;
}

.badge-default {
  background-color: #f1f5f9;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
}

/* 通用按压动效 */
.hover-effect {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 全局弹窗通用遮罩与对话框 */
.modal-mask {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background: rgba(15, 23, 42, 0.6) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 99999 !important;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-dialog {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 32rpx 36rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f1f5f9;
  padding: 24rpx 36rpx 32rpx;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  background: #f1f5f9;
  color: #64748b;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
}

.btn-confirm {
  flex: 1;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

/* 全局表单输入框高度与舒适排版 (彻底解决微信input文字过扁/看不到输入问题) */
.text-input {
  height: 88rpx !important;
  min-height: 88rpx !important;
  line-height: 88rpx !important;
  padding: 0 24rpx !important;
  font-size: 30rpx !important;
  color: #0f172a !important;
  background: #f8fafc !important;
  border: 2rpx solid #cbd5e1 !important;
  border-radius: 16rpx !important;
  width: 100% !important;
  box-sizing: border-box !important;
  display: block !important;
}

.text-input:focus {
  border-color: #1677ff !important;
  background: #ffffff !important;
}

.placeholder-style {
  color: #94a3b8 !important;
  font-size: 28rpx !important;
  line-height: 88rpx !important;
}
