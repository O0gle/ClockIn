/* pages/settings/settings.wxss */

.settings-container {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 1. 当前生效规则速览卡片 */
.rules-summary-card {
  padding: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border: 1rpx solid #e2e8f0;
}

.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.summary-badge {
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #bfdbfe;
}

.reset-link {
  font-size: 24rpx;
  color: #64748b;
  text-decoration: underline;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.sum-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
}

.sum-label {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.sum-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
  font-variant-numeric: tabular-nums;
}

.sum-hint {
  font-size: 20rpx;
  color: #94a3b8;
}

.sum-overtime {
  background: #fff7ed;
  border-color: #fed7aa;
}

.ot-color {
  color: #ea580c !important;
}

.ot-sub {
  color: #f97316 !important;
}

.ot-val {
  color: #ea580c !important;
  font-weight: 700 !important;
}

/* 2. 表单设置区 */
.form-section {
  padding: 32rpx;
}

.section-title {
  margin-bottom: 24rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.section-sub-text {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: 12rpx;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.setting-row:last-child {
  border-bottom: none;
}

.row-highlight {
  background: #fff7ed;
  margin: 12rpx -16rpx;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  border-bottom: none;
}

.row-weekend-rule {
  background: #f5f3ff;
  margin: 12rpx -16rpx;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  border-bottom: none;
}

.text-purple {
  color: #7c3aed !important;
}

.weekend-tag {
  background: #ede9fe;
  color: #7c3aed;
  border: 1rpx solid #ddd6fe;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.row-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.row-desc {
  font-size: 22rpx;
  color: #94a3b8;
}

.row-picker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 14rpx;
  padding: 12rpx 20rpx;
}

.row-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.row-arrow {
  font-size: 28rpx;
  color: #94a3b8;
  line-height: 1;
}

/* 3. 数据与辅助工具 */
.data-section {
  padding: 32rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.action-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.item-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f1f5f9;
}

.item-icon-wrap.wrap-excel {
  background: #ecfdf5;
}

.item-icon-wrap.wrap-import {
  background: #fdf4ff;
}

.item-icon-wrap.wrap-demo {
  background: #eff6ff;
}

.item-icon-wrap.wrap-danger {
  background: #fef2f2;
}

.item-icon {
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-text-group {
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.item-desc {
  font-size: 22rpx;
  color: #94a3b8;
}

.action-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}

.text-danger {
  color: #dc2626 !important;
}

/* 4. 关于卡片 */
.about-card {
  padding: 32rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.about-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.about-app-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.about-version {
  font-size: 20rpx;
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.about-rules-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.about-rule-item {
  display: flex;
  align-items: flex-start;
  font-size: 25rpx;
  line-height: 1.6;
}

.about-num {
  font-weight: 700;
  color: #2563eb;
  flex-shrink: 0;
  margin-top: 1rpx;
}

.about-content {
  flex: 1;
}

.about-bold {
  font-weight: 700;
  color: #1e293b;
}

.about-text {
  color: #475569;
}
