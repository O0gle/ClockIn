<!--pages/settings/settings.wxml-->
<scroll-view class="settings-container" scroll-y>
  <!-- 1. 当前生效规则速览卡片 -->
  <view class="rules-summary-card card">
    <view class="summary-top">
      <text class="summary-badge">当前生效规则</text>
      <text class="reset-link" bindtap="resetToDefault">恢复默认</text>
    </view>
    <view class="summary-grid">
      <view class="sum-item">
        <text class="sum-label">弹性上班区间</text>
        <text class="sum-val">{{flexStartRangeText}}</text>
        <text class="sum-hint">基准 {{settings.baseStartTime}} (±{{settings.startFlexMinutes}}m)</text>
      </view>
      <view class="sum-item">
        <text class="sum-label">午休时间 (扣除)</text>
        <text class="sum-val">{{settings.lunchStart}} ~ {{settings.lunchEnd}}</text>
        <text class="sum-hint">工作日扣除 {{lunchDurationText}}</text>
      </view>
      <view class="sum-item">
        <text class="sum-label">工作日加班规则</text>
        <text class="sum-val ot-color">{{weekdayOvertimeRuleText}}</text>
        <text class="sum-hint ot-color">休息1h内不计入加班</text>
      </view>
      <view class="sum-item sum-overtime">
        <text class="sum-label ot-color">周六日加班规则</text>
        <text class="sum-val ot-color">全额计加班</text>
        <text class="sum-hint ot-color">中午和晚上休息均计入</text>
      </view>
    </view>
  </view>

  <!-- 2. 考勤参数调整区 -->
  <view class="form-section card">
    <view class="section-title">
      <text class="section-title-text">考勤规则个性化设置</text>
      <text class="section-sub-text">点击即可修改各参数</text>
    </view>

    <!-- 1. 上班基准 -->
    <view class="setting-row">
      <view class="row-left">
        <text class="row-title">上班基准时间</text>
        <text class="row-desc">默认 08:30，弹性中心点</text>
      </view>
      <picker mode="time" value="{{settings.baseStartTime}}" bindchange="onBaseStartTimeChange">
        <view class="row-picker">
          <text class="row-val">{{settings.baseStartTime}}</text>
          <text class="row-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 2. 上班弹性幅度 -->
    <view class="setting-row">
      <view class="row-left">
        <text class="row-title">上班弹性幅度</text>
        <text class="row-desc">当前: {{flexStartRangeText}}</text>
      </view>
      <picker range="{{flexOptionsLabels}}" value="{{startFlexIndex}}" bindchange="onStartFlexChange">
        <view class="row-picker">
          <text class="row-val">±{{settings.startFlexMinutes}} 分钟</text>
          <text class="row-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 3. 午休开始 -->
    <view class="setting-row">
      <view class="row-left">
        <text class="row-title">午休开始时间</text>
        <text class="row-desc">工作日开始不计入工作时长</text>
      </view>
      <picker mode="time" value="{{settings.lunchStart}}" bindchange="onLunchStartChange">
        <view class="row-picker">
          <text class="row-val">{{settings.lunchStart}}</text>
          <text class="row-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 4. 午休结束 -->
    <view class="setting-row">
      <view class="row-left">
        <text class="row-title">午休结束时间</text>
        <text class="row-desc">结束午休，恢复计算工时</text>
      </view>
      <picker mode="time" value="{{settings.lunchEnd}}" bindchange="onLunchEndChange">
        <view class="row-picker">
          <text class="row-val">{{settings.lunchEnd}}</text>
          <text class="row-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 5. 下班基准 -->
    <view class="setting-row">
      <view class="row-left">
        <text class="row-title">下班基准时间</text>
        <text class="row-desc">默认 18:00，标准7.5h下班点</text>
      </view>
      <picker mode="time" value="{{settings.baseEndTime}}" bindchange="onBaseEndTimeChange">
        <view class="row-picker">
          <text class="row-val">{{settings.baseEndTime}}</text>
          <text class="row-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 6. 下班弹性幅度 -->
    <view class="setting-row">
      <view class="row-left">
        <text class="row-title">下班弹性幅度</text>
        <text class="row-desc">当前: {{flexEndRangeText}}</text>
      </view>
      <picker range="{{flexOptionsLabels}}" value="{{endFlexIndex}}" bindchange="onEndFlexChange">
        <view class="row-picker">
          <text class="row-val">±{{settings.endFlexMinutes}} 分钟</text>
          <text class="row-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 7. 工作日下班后休息时长 (重点规则修正) -->
    <view class="setting-row row-highlight">
      <view class="row-left">
        <text class="row-title ot-color">工作日下班休息时长</text>
        <text class="row-desc ot-sub">工作日满工时后休息该时长才起算加班</text>
      </view>
      <picker range="{{restOptionsLabels}}" value="{{restIndex}}" bindchange="onWeekdayRestChange">
        <view class="row-picker">
          <text class="row-val ot-val">{{settings.weekdayRestMinutes || 60}} 分钟</text>
          <text class="row-arrow ot-color">›</text>
        </view>
      </picker>
    </view>

    <!-- 8. 周末加班规则说明 -->
    <view class="setting-row row-weekend-rule">
      <view class="row-left">
        <text class="row-title text-purple">周六周日加班规则</text>
        <text class="row-desc">全天出勤计加班，把中午与晚上休息全额计入</text>
      </view>
      <view class="weekend-tag">
        <text>休息全计入</text>
      </view>
    </view>
  </view>

  <!-- 3. 邮箱备份与导出 (免费云端备份方案) -->
  <view class="email-section card">
    <view class="section-title-between">
      <view>
        <text class="section-title-text">邮箱备份与报表导出</text>
        <text class="section-sub-text">100% 永久免费</text>
      </view>
      <text class="config-link" bindtap="openEmailModal">{{emailConfig.targetEmail ? '修改邮箱' : '配置邮箱'}}</text>
    </view>

    <!-- 邮箱状态条 -->
    <view class="email-status-bar" bindtap="openEmailModal">
      <view class="email-bar-left">
        <text class="email-icon">📬</text>
        <view class="email-info">
          <text class="email-addr">{{emailConfig.targetEmail || '未绑定接收邮箱 (点击设置)'}}</text>
          <text class="email-sub">{{emailConfig.targetEmail ? '已就绪，点击可随时修改' : '填入QQ/163/工作邮箱即可一键备份'}}</text>
        </view>
      </view>
      <text class="email-arrow">›</text>
    </view>

    <!-- 邮件操作按钮 -->
    <view class="email-btn-group">
      <button class="email-act-btn primary" hover-class="hover-effect" bindtap="triggerSendEmail">
        <text>✉ 发送当月考勤报表到邮箱</text>
      </button>
      <button class="email-act-btn" hover-class="hover-effect" bindtap="exportCsvReport">
        <text>📊 导出 Excel (CSV) 文件</text>
      </button>
    </view>
  </view>

  <!-- 4. 数据管理与演示 -->
  <view class="data-section card">
    <view class="section-title">
      <text class="section-title-text">数据与辅助工具</text>
    </view>

    <view class="action-list">
      <view class="action-item" hover-class="hover-effect" bindtap="loadDemoData">
        <view class="item-left">
          <text class="item-icon">✨</text>
          <view class="item-text-group">
            <text class="item-title">导入演示示例数据</text>
            <text class="item-desc">生成工作日休息1h起算加班、周六日全额计加班的代表性样本</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>

      <view class="action-item" hover-class="hover-effect" bindtap="exportBackupData">
        <view class="item-left">
          <text class="item-icon">📦</text>
          <view class="item-text-group">
            <text class="item-title">备份全部考勤数据</text>
            <text class="item-desc">复制全部打卡与配置为 JSON 文本</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>

      <view class="action-item danger-item" hover-class="hover-effect" bindtap="clearAllRecords">
        <view class="item-left">
          <text class="item-icon">🗑</text>
          <view class="item-text-group">
            <text class="item-title text-danger">清空所有打卡记录</text>
            <text class="item-desc">清除手机本地保存的历史打卡记录</text>
          </view>
        </view>
        <text class="action-arrow text-danger">›</text>
      </view>
    </view>
  </view>

  <!-- 5. 关于卡片 -->
  <view class="about-card card">
    <view class="about-header">
      <text class="about-app-name">弹性打卡助手</text>
      <text class="about-version">v1.2.0 (邮件云备份版)</text>
    </view>
    <text class="about-desc">支持工作日弹性上下班（08:30±30m、18:00±30m），自动扣除11:40~13:40午休；工作日下班后休息1小时才开始计算加班时长；周六周日出勤全天计加班，且中午和晚上的休息时间都全额计入加班时长。支持全量数据直发个人邮箱，零费用持久保存。</text>
  </view>
</scroll-view>

<!-- 邮箱设置弹窗 -->
<view class="modal-mask" wx:if="{{showEmailModal}}" bindtap="closeEmailModal">
  <view class="modal-dialog" catchtap="true">
    <view class="modal-header">
      <text class="modal-title">设置备份邮箱</text>
      <text class="modal-close" bindtap="closeEmailModal">✕</text>
    </view>

    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">接收邮箱地址 *</text>
        <input class="text-input" placeholder="例如：your_name@qq.com" value="{{emailConfig.targetEmail}}" bindinput="onTargetEmailInput" />
        <text class="form-item-tip">用于接收月度考勤、加班报表与数据恢复备份。</text>
      </view>

      <view class="form-item">
        <text class="form-label">Web3Forms Access Key (用于一键直发)</text>
        <input class="text-input" placeholder="可填入免费 Key (可选)" value="{{emailConfig.accessKey}}" bindinput="onAccessKeyInput" />
        <text class="form-item-tip">💡 提示：访问 web3forms.com 填写邮箱即可免费秒获 Key；若不填也可一键复制完整邮件文本或导出Excel发信！</text>
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn-cancel" bindtap="closeEmailModal">取消</button>
      <button class="btn-confirm" bindtap="saveEmailConfigOnly">保存邮箱</button>
    </view>
  </view>
</view>
