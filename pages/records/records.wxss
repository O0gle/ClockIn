/* pages/records/records.wxss */

.records-container {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 1. 顶部月份导航与视图切换 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.month-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.arrow-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #475569;
  font-weight: 700;
  line-height: 1;
}

.month-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.month-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.dropdown-icon {
  font-size: 20rpx;
  color: #94a3b8;
}

.view-switch {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
}

.switch-btn {
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
  transition: all 0.2s;
}

.switch-btn.active {
  background: #ffffff;
  color: #1677ff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 2. 当月考勤概览 */
.stats-overview {
  padding: 32rpx 28rpx 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  font-family: -apple-system, BlinkMacSystemFont, 'DIN Alternate', sans-serif;
}

.stat-unit {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.stat-title {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  white-space: nowrap;
}

.stat-overtime {
  background: #fff7ed;
}

.ot-color {
  color: #ea580c !important;
  font-weight: 600;
}

.text-warning {
  color: #d97706;
}

.stats-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 20rpx;
}

.footer-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tip-icon {
  font-size: 24rpx;
  color: #94a3b8;
}

.tip-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.export-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.export-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.export-link.link-excel {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.export-link.link-excel .export-text {
  color: #059669;
}

.export-link.link-import {
  background: #fdf4ff;
  border-color: #f5d0fe;
}

.export-link.link-import .export-text {
  color: #9333ea;
}

.export-icon {
  font-size: 22rpx;
}

.export-text {
  font-size: 22rpx;
  color: #2563eb;
  font-weight: 500;
}

/* 3. 日历视图 */
.calendar-card {
  padding: 24rpx 20rpx;
}

.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 16rpx;
}

.week-item {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.day-cell {
  aspect-ratio: 1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
  position: relative;
  transition: all 0.15s ease;
}

.day-cell:active {
  transform: scale(0.96);
}

.day-cell.other-month {
  background: transparent;
}

.day-cell.today-day {
  border-color: #93c5fd;
  background: #eff6ff;
}

.day-cell.today-day .day-number {
  color: #2563eb;
  font-weight: 700;
}

.day-cell.selected-day {
  border-color: #2563eb;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.2);
}

.day-number {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
}

.day-tag-area {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 24rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.dot-success {
  background: #10b981;
}

.dot-warning {
  background: #f59e0b;
}

.ot-badge {
  background: #ea580c;
  color: #ffffff;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}

.ot-badge.ot-badge-weekend {
  background: #7c3aed;
}

.ot-badge.ot-badge-normal {
  background: #10b981;
}

.ot-badge.ot-badge-warning {
  background: #f59e0b;
}

/* 选中的日期详情卡片 */
.selected-detail-card {
  padding: 28rpx 32rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-date-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn-sm {
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.action-btn-sm.text-danger {
  color: #dc2626;
  background: #fef2f2;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.detail-label {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.detail-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
}

.detail-sub {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.detail-ot {
  background: #fff7ed;
}

.detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 10rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
}

.empty-add-btn {
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 20rpx;
  padding: 10rpx 28rpx;
  line-height: 1.4;
}

.detail-remark {
  margin-top: 16rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 24rpx;
}

.remark-title {
  color: #64748b;
}

.remark-text {
  color: #1e293b;
}

/* 4. 列表视图 */
.list-section {
  display: flex;
  flex-direction: column;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
}

.add-record-btn {
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
  font-weight: 500;
}

.record-row-card {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.record-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.row-date-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.row-btn-group {
  display: flex;
  gap: 20rpx;
}

.row-edit-link {
  font-size: 24rpx;
  color: #2563eb;
}

.row-del-link {
  font-size: 24rpx;
  color: #dc2626;
}

.record-data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.data-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.col-label {
  font-size: 20rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
}

.col-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  font-variant-numeric: tabular-nums;
}

.ot-col {
  background: #fff7ed;
  border-radius: 10rpx;
  padding: 4rpx 10rpx;
}

.ot-val {
  color: #ea580c;
}

.data-arrow {
  color: #cbd5e1;
  font-size: 24rpx;
}

.row-remark {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
}

.remark-tag {
  background: #e2e8f0;
  color: #475569;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.remark-content {
  color: #64748b;
}

.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 16rpx 40rpx;
  border: none;
}

/* 底部导出当月考勤报表按钮 */
.bottom-export-section {
  margin: 36rpx 8rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.export-month-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff !important;
  border-radius: 20rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.25);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.export-hint-text {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 14rpx;
}

/* 弹窗通用样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 10rpx;
}

.modal-body {
  padding: 32rpx 36rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-static-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.label-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.toggle-pwd-link {
  font-size: 22rpx;
  color: #1677ff;
  font-weight: 500;
}

.date-picker-box {
  background: #eff6ff !important;
  border-color: #bfdbfe !important;
}

.date-picker-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-icon {
  font-size: 30rpx;
}

.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}

.picker-val {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #94a3b8;
}

.picker-arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

.text-input {
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #f8fafc;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.text-input:focus {
  border-color: #1677ff;
  background: #ffffff;
}

.placeholder-style {
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 88rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f1f5f9;
  padding: 24rpx 36rpx 32rpx;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  background: #f1f5f9;
  color: #64748b;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
}

.btn-confirm {
  flex: 1;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}
