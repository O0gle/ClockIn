<!--pages/records/records.wxml-->
<scroll-view class="records-container" scroll-y>
  <!-- 1. 月份切换与视图切换栏 -->
  <view class="nav-bar card">
    <view class="month-selector">
      <view class="arrow-btn" hover-class="hover-effect" bindtap="prevMonth">‹</view>
      <picker mode="date" fields="month" value="{{monthPickerValue}}" bindchange="onMonthChange">
        <view class="month-label">
          <text class="month-text">{{currentYear}}年 {{currentMonth}}月</text>
          <text class="dropdown-icon">▼</text>
        </view>
      </picker>
      <view class="arrow-btn" hover-class="hover-effect" bindtap="nextMonth">›</view>
    </view>

    <!-- 视图模式切换 (日历 / 列表) -->
    <view class="view-switch">
      <view class="switch-btn {{viewMode === 'calendar' ? 'active' : ''}}" data-mode="calendar" bindtap="switchView">
        <text>日历</text>
      </view>
      <view class="switch-btn {{viewMode === 'list' ? 'active' : ''}}" data-mode="list" bindtap="switchView">
        <text>列表</text>
      </view>
    </view>
  </view>

  <!-- 2. 当月考勤统计汇总卡片 -->
  <view class="stats-overview card">
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-num">{{statistics.totalDays || 0}}</text>
        <text class="stat-unit">天</text>
        <text class="stat-title">出勤天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{statistics.totalWorkHours || '0.0'}}</text>
        <text class="stat-unit">小时</text>
        <text class="stat-title">出勤总工时</text>
      </view>
      <!-- 累计加班重点展示 -->
      <view class="stat-item stat-overtime">
        <text class="stat-num ot-color">{{statistics.totalOvertimeHours || '0.0'}}</text>
        <text class="stat-unit ot-color">小时</text>
        <text class="stat-title ot-color">累计加班时长</text>
      </view>
      <view class="stat-item">
        <text class="stat-num {{statistics.lateCount > 0 ? 'text-warning' : ''}}">{{statistics.lateCount || 0}}</text>
        <text class="stat-unit">次</text>
        <text class="stat-title">迟到记录</text>
      </view>
    </view>

    <view class="stats-footer">
      <view class="footer-tip">
        <text class="tip-icon">ℹ</text>
        <text class="tip-text">工作日下班休息1h起算 / 周末休息全计入加班</text>
      </view>
      <view class="export-actions">
        <view class="export-link link-email" hover-class="hover-effect" bindtap="sendMonthEmail">
          <text class="export-icon">✉</text>
          <text class="export-text">发邮箱</text>
        </view>
        <view class="export-link" hover-class="hover-effect" bindtap="exportCsvReport">
          <text class="export-icon">📊</text>
          <text class="export-text">Excel</text>
        </view>
        <view class="export-link" hover-class="hover-effect" bindtap="exportMonthData">
          <text class="export-icon">📋</text>
          <text class="export-text">复制</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3A. 日历视图模式 -->
  <view class="calendar-card card" wx:if="{{viewMode === 'calendar'}}">
    <!-- 星期表头 -->
    <view class="week-header">
      <text class="week-item">日</text>
      <text class="week-item">一</text>
      <text class="week-item">二</text>
      <text class="week-item">三</text>
      <text class="week-item">四</text>
      <text class="week-item">五</text>
      <text class="week-item">六</text>
    </view>

    <!-- 日历日期网格 -->
    <view class="calendar-grid">
      <block wx:for="{{calendarDays}}" wx:key="index">
        <view class="day-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.dateStr === selectedDateStr ? 'selected-day' : ''}} {{item.isToday ? 'today-day' : ''}}"
              data-item="{{item}}" bindtap="onSelectDay">
          <text class="day-number">{{item.dayNumber}}</text>

          <!-- 考勤状态小圆点与加班标签 -->
          <view class="day-tag-area" wx:if="{{item.hasRecord}}">
            <view wx:if="{{item.statusType === 'weekend_ot'}}" class="ot-badge ot-badge-weekend">
              <text>{{item.overtimeText}}</text>
            </view>
            <view wx:elif="{{item.statusType === 'overtime'}}" class="ot-badge">
              <text>{{item.overtimeText}}</text>
            </view>
            <view wx:elif="{{item.statusType === 'normal'}}" class="dot dot-success"></view>
            <view wx:elif="{{item.statusType === 'abnormal'}}" class="dot dot-warning"></view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 选中的单日记录详情卡片 (在日历下方) -->
  <view class="selected-detail-card card" wx:if="{{viewMode === 'calendar' && selectedDateStr}}">
    <view class="detail-header">
      <view class="detail-date-wrap">
        <text class="detail-date">{{selectedDateStr}}</text>
        <text class="badge badge-{{selectedDayRecord.overtimeMinutes > 0 ? 'accent' : (selectedDayRecord.summaryStatus === 'normal' ? 'success' : 'default')}}">
          {{selectedDayRecord.summaryStatusText || '未打卡'}}
        </text>
      </view>
      <view class="detail-actions">
        <view class="action-btn-sm" hover-class="hover-effect" data-date="{{selectedDateStr}}" bindtap="openEditModal">
          <text>✎ 补卡/修改</text>
        </view>
        <view wx:if="{{selectedDayRecord.signInTime || selectedDayRecord.signOutTime}}" class="action-btn-sm text-danger" hover-class="hover-effect" data-date="{{selectedDateStr}}" bindtap="deleteRecord">
          <text>删除</text>
        </view>
      </view>
    </view>

    <view class="detail-grid" wx:if="{{selectedDayRecord.signInTime || selectedDayRecord.signOutTime}}">
      <view class="detail-item">
        <text class="detail-label">上班打卡</text>
        <text class="detail-val">{{selectedDayRecord.signInTime || '--:--'}}</text>
        <text class="detail-sub">{{selectedDayRecord.signInStatusText || ''}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">预计下班</text>
        <text class="detail-val">{{selectedDayRecord.expectedSignOutTime || '--:--'}}</text>
        <text class="detail-sub">弹性满7.5h</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">下班打卡</text>
        <text class="detail-val">{{selectedDayRecord.signOutTime || '--:--'}}</text>
        <text class="detail-sub">{{selectedDayRecord.signOutStatusText || ''}}</text>
      </view>
      <view class="detail-item detail-ot">
        <text class="detail-label">加班时长</text>
        <text class="detail-val ot-color">{{selectedDayRecord.overtimeText || '0分钟'}}</text>
        <text class="detail-sub ot-color">{{selectedDayRecord.isWeekend ? '全额计入' : '休息1h后起算'}}</text>
      </view>
    </view>

    <view class="detail-empty" wx:else>
      <text class="empty-text">该日期暂无打卡记录</text>
      <button class="empty-add-btn" data-date="{{selectedDateStr}}" bindtap="openEditModal">+ 为该日补卡</button>
    </view>

    <view class="detail-remark" wx:if="{{selectedDayRecord.remark}}">
      <text class="remark-title">备注：</text>
      <text class="remark-text">{{selectedDayRecord.remark}}</text>
    </view>
  </view>

  <!-- 3B. 列表视图模式 -->
  <view class="list-section" wx:if="{{viewMode === 'list'}}">
    <view class="list-header">
      <text class="list-title">考勤明细列表 (共 {{statistics.records.length}} 条)</text>
      <view class="add-record-btn" hover-class="hover-effect" data-date="{{selectedDateStr}}" bindtap="openEditModal">
        <text>+ 补充打卡</text>
      </view>
    </view>

    <block wx:if="{{statistics.records && statistics.records.length > 0}}">
      <block wx:for="{{statistics.records}}" wx:key="date">
        <view class="record-row-card card">
          <view class="record-row-top">
            <view class="row-date-group">
              <text class="row-date">{{item.date}}</text>
              <text class="badge badge-{{item.overtimeMinutes > 0 ? 'accent' : (item.summaryStatus === 'normal' ? 'success' : 'warning')}}">
                {{item.summaryStatusText}}
              </text>
            </view>
            <view class="row-btn-group">
              <text class="row-edit-link" data-date="{{item.date}}" bindtap="openEditModal">编辑</text>
              <text class="row-del-link" data-date="{{item.date}}" bindtap="deleteRecord">删除</text>
            </view>
          </view>

          <view class="record-data-row">
            <view class="data-col">
              <text class="col-label">上班</text>
              <text class="col-val">{{item.signInTime || '--:--'}}</text>
            </view>
            <view class="data-arrow">→</view>
            <view class="data-col">
              <text class="col-label">下班</text>
              <text class="col-val">{{item.signOutTime || '--:--'}}</text>
            </view>
            <view class="data-col">
              <text class="col-label">工时</text>
              <text class="col-val">{{item.workText}}</text>
            </view>
            <view class="data-col ot-col">
              <text class="col-label">{{item.isWeekend ? '加班(全额计)' : '加班(休息1h起)'}}</text>
              <text class="col-val ot-val">{{item.overtimeText}}</text>
            </view>
          </view>

          <view class="row-remark" wx:if="{{item.remark}}">
            <text class="remark-tag">备注</text>
            <text class="remark-content">{{item.remark}}</text>
          </view>
        </view>
      </block>
    </block>
    <view class="empty-list card" wx:else>
      <text class="empty-icon">📂</text>
      <text class="empty-title">本月暂无打卡明细</text>
      <text class="empty-desc">前往首页打卡，或点击下方按钮手动补卡</text>
      <button class="empty-btn" bindtap="openEditModal">+ 手动补录考勤</button>
    </view>
  </view>
</scroll-view>

<!-- 补卡/编辑弹窗 -->
<view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal">
  <view class="modal-dialog" catchtap="true">
    <view class="modal-header">
      <text class="modal-title">考勤补卡 / 编辑记录</text>
      <text class="modal-close" bindtap="closeEditModal">✕</text>
    </view>

    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">打卡日期</text>
        <text class="form-static-text">{{editDate}}</text>
      </view>

      <view class="form-item">
        <text class="form-label">上班打卡时间</text>
        <picker mode="time" value="{{editSignInTime}}" bindchange="onEditSignInChange">
          <view class="picker-input">
            <text class="{{editSignInTime ? 'picker-val' : 'picker-placeholder'}}">{{editSignInTime || '选择时间 (如 08:30)'}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">下班打卡时间</text>
        <picker mode="time" value="{{editSignOutTime}}" bindchange="onEditSignOutChange">
          <view class="picker-input">
            <text class="{{editSignOutTime ? 'picker-val' : 'picker-placeholder'}}">{{editSignOutTime || '选择时间 (如 18:00)'}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">备注 (例如：调休、外勤、事假)</text>
        <input class="text-input" placeholder="输入备注说明" value="{{editRemark}}" bindinput="onEditRemarkChange" />
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn-cancel" bindtap="closeEditModal">取消</button>
      <button class="btn-confirm" bindtap="saveEditRecord">保存记录</button>
    </view>
  </view>
</view>
